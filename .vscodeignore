.vscode/**
.vscode-test/**
src/**
out/test/**
out/**/*.test.cjs
out/**/*.map
!out/extension.js
node_modules/**

# CI (dev-only, not shipped to marketplace users)
.github/**

# Dev tool data (not for marketplace users)
.superpowers/**
.claude/**
.qodo/**
docs/**

# Internal docs (CHANGELOG.md is intentionally shipped — registries render it on the Changes tab)
CLAUDE.md

# Media assets not used in the marketplace listing
media/icon.svg
media/icon-activity.svg

# Demo recordings, GIFs and README screenshots — safe to exclude because the
# listing NEVER reads the packaged copies. Marketplace/Open VSX render the README
# and fetch its images over HTTPS from GitHub: our README uses absolute
# raw.githubusercontent.com URLs, and even relative paths wouldn't have needed the
# files here — `vsce package` rewrites them to https://github.com/<repo>/raw/HEAD/...
# using the `repository` field (verified by packaging a fixture).
#
# Consequence: images must be pushed to the default branch before publishing, or
# the listing renders broken images.
#
# media/icon.png and media/icon-activity.png MUST keep shipping — package.json
# points at them for the extension icon and the activity-bar container.
media/*.mp4
media/demo.gif
media/ClaudeGateDemo.png
media/ReviewAllPending.png

# Build and lint config
.gitignore
.gitattributes
.eslintrc.json
.eslintrc*
tsconfig.json
tsconfig*.json
.editorconfig
.prettierrc*
.eslintignore

# Hook tests (dev-only, not shipped to marketplace users)
hooks/tests/**
**/__pycache__/**

# Manual test aids (dev-only, not shipped to marketplace users)
MANUAL-TEST-1.3.0.md
manual-test-seed.py

# Misc
*.vsix
test.txt
